# Genkit / OpenAI-compatible API (server-side only)
base_url=https://your-provider.example/v1
model=gpt-4.1
OPENAI_API_KEY=

# Vercel populates VERCEL_OIDC_TOKEN automatically for linked local commands.
# Never commit .env.local or any token value.

# Turso
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Portal credentials. Use strong values in Vercel and keep them private.
AUTH_SECRET=
LANDLORD_EMAIL=
LANDLORD_PASSWORD=
TENANT_EMAIL=
TENANT_PASSWORD=

# Mercado Pago Checkout Pro (server-side access token; never expose it in the browser)
MERCADOPAGO_ACCESS_TOKEN=
# Public key is optional for Checkout Pro and needed later for embedded Brick checkout.
MERCADOPAGO_PUBLIC_KEY=
# Configure after creating and securing the Mercado Pago webhook endpoint.
MERCADOPAGO_WEBHOOK_SECRET=

# Google OAuth (configure no Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://loca-facil.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=